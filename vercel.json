{
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npm run config && npm run build",
  "outputDirectory": "dist/Portfolio_frontend_v2/browser",
  "headers": [
    {
      "source": "/index.csr.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.csr.html"
    },
    {
      "source": "/(es|en)/projectDetails/(.*)",
      "destination": "/index.csr.html"
    },
    {
      "source": "/projectDetails/(.*)",
      "destination": "/index.csr.html"
    },
    {
      "source": "/(es|en)/admin/(.*)",
      "destination": "/index.csr.html"
    },
    {
      "source": "/(es|en)/admin",
      "destination": "/index.csr.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.csr.html"
    },
    {
      "source": "/admin",
      "destination": "/index.csr.html"
    }
  ]
}
